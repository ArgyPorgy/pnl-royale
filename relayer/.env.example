# Same network variables as the app (the relayer imports the shared SDK)
NEXT_PUBLIC_CLUSTER=mainnet
NEXT_PUBLIC_L1_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_ER_RPC=https://mainnet-tee.magicblock.app
NEXT_PUBLIC_ER_VALIDATOR=MTEWGuqxUpYZGFJQcp8tLN7x5v9BSeoFHYWQQ3n3xzo
NEXT_PUBLIC_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Fee-payer keypair (a Boost address). Holds a little SOL for start_room deposits, ATA rent and settle fees.
RELAYER_KEYPAIR=/path/to/royale-relayer.json
# Comma-separated room ids to always watch (if the RPC blocks getProgramAccounts)
WATCH_ROOMS=
PORT=8787
# Set to 0 to make the relayer ER-only (no SOL spend)
L1_ACTIONS=1
