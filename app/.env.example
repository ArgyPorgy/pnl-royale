# Network: devnet (default, the live deployment) | mainnet | localnet
NEXT_PUBLIC_CLUSTER=devnet
# Defaults per network are in src/lib/royale/constants.ts. Override when needed:
# NEXT_PUBLIC_L1_RPC=https://rpc.magicblock.app/devnet
# NEXT_PUBLIC_ER_RPC=https://devnet-tee.magicblock.app
# NEXT_PUBLIC_ER_VALIDATOR=MTEWGuqxUpYZGFJQcp8tLN7x5v9BSeoFHYWQQ3n3xzo
# NEXT_PUBLIC_USDC_MINT=THPHkxhRHRJE3oVWMpPqQ82F3TCWVUY5rHUxotjfQre
# NEXT_PUBLIC_PROGRAM_ID=7t2L4552mactTH9NiCcGQ3LeUgCBYi81B1qMfGTeRBJ5
# L1 priority fee in micro-lamports per CU (default 50000 on mainnet, 0 elsewhere)
# NEXT_PUBLIC_PRIORITY_MICROLAMPORTS=
# Optional: relayer room index for the lobby
# NEXT_PUBLIC_RELAYER_URL=

# Server-only (devnet): the faucet key, a JSON byte array. Must be the test-USDC mint authority
# and hold some devnet SOL. Never set this on mainnet.
FAUCET_SECRET_KEY=

# Server-only: the house bots' pool wallet, a JSON byte array. It funds each bot seat and takes the
# winnings back. Required for bots on mainnet (the faucet key is never used there); on devnet the
# faucet key is the pool when this is unset. Keep only what you can afford to lose in it.
# BOT_POOL_SECRET_KEY=
# Server-only RPCs the /analytics page reads for each network, whichever network this site runs.
# Use a Helius/Triton URL for mainnet: it stays on the server, so an API key in it is never exposed.
# MAINNET_RPC_URL=
# DEVNET_RPC_URL=
# Bot limits in USDC ("off" for none). Mainnet defaults: 1, 10 and 10; devnet has none unless set.
# BOT_MAX_ENTRY_USDC=1
# BOT_DAILY_LOSS_USDC=10
# BOT_ROOMS_PER_PLAYER_DAY=10
